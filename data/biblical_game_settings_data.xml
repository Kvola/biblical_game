<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Configuration par défaut - Bible complète -->
        <record id="complete_bible_settings" model="biblical.game.settings">
            <field name="name">Bible Complète</field>
            <field name="timer_duration">30</field>
            <field name="max_questions_per_game">10</field>
            <field name="difficulty_level">medium</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="True"/>
            <!-- book_ids sera renseigné dynamiquement ou manuellement -->
        </record>

        <!-- Configuration Nouveau Testament -->
        <record id="new_testament_settings" model="biblical.game.settings">
            <field name="name">Nouveau Testament</field>
            <field name="timer_duration">25</field>
            <field name="max_questions_per_game">8</field>
            <field name="difficulty_level">easy</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Ancien Testament -->
        <record id="old_testament_settings" model="biblical.game.settings">
            <field name="name">Ancien Testament</field>
            <field name="timer_duration">40</field>
            <field name="max_questions_per_game">15</field>
            <field name="difficulty_level">hard</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Évangiles -->
        <record id="gospels_settings" model="biblical.game.settings">
            <field name="name">Les Quatre Évangiles</field>
            <field name="timer_duration">20</field>
            <field name="max_questions_per_game">6</field>
            <field name="difficulty_level">easy</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Épîtres Pauliniennes -->
        <record id="paul_epistles_settings" model="biblical.game.settings">
            <field name="name">Épîtres de Paul</field>
            <field name="timer_duration">30</field>
            <field name="max_questions_per_game">10</field>
            <field name="difficulty_level">medium</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Livres Poétiques -->
        <record id="poetic_books_settings" model="biblical.game.settings">
            <field name="name">Livres Poétiques</field>
            <field name="timer_duration">35</field>
            <field name="max_questions_per_game">8</field>
            <field name="difficulty_level">medium</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Pentateuque -->
        <record id="pentateuch_settings" model="biblical.game.settings">
            <field name="name">Pentateuque (Torah)</field>
            <field name="timer_duration">35</field>
            <field name="max_questions_per_game">12</field>
            <field name="difficulty_level">hard</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration Prophètes -->
        <record id="prophets_settings" model="biblical.game.settings">
            <field name="name">Livres Prophétiques</field>
            <field name="timer_duration">40</field>
            <field name="max_questions_per_game">12</field>
            <field name="difficulty_level">hard</field>
            <field name="allow_hints" eval="False"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration pour débutants -->
        <record id="beginner_settings" model="biblical.game.settings">
            <field name="name">Mode Débutant</field>
            <field name="timer_duration">45</field>
            <field name="max_questions_per_game">5</field>
            <field name="difficulty_level">easy</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration pour experts -->
        <record id="expert_settings" model="biblical.game.settings">
            <field name="name">Mode Expert</field>
            <field name="timer_duration">20</field>
            <field name="max_questions_per_game">20</field>
            <field name="difficulty_level">hard</field>
            <field name="allow_hints" eval="False"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration pour tournoi -->
        <record id="tournament_settings" model="biblical.game.settings">
            <field name="name">Mode Tournoi</field>
            <field name="timer_duration">25</field>
            <field name="max_questions_per_game">15</field>
            <field name="difficulty_level">medium</field>
            <field name="allow_hints" eval="False"/>
            <field name="active" eval="False"/>
        </record>

    </data>

    <!-- Données de démo pour les tests -->
    <data noupdate="0">
        
        <!-- Configuration de test -->
        <record id="test_settings" model="biblical.game.settings">
            <field name="name">Configuration de Test</field>
            <field name="timer_duration">10</field>
            <field name="max_questions_per_game">3</field>
            <field name="difficulty_level">easy</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Configuration de développement -->
        <record id="dev_settings" model="biblical.game.settings">
            <field name="name">Mode Développement</field>
            <field name="timer_duration">5</field>
            <field name="max_questions_per_game">1</field>
            <field name="difficulty_level">easy</field>
            <field name="allow_hints" eval="True"/>
            <field name="active" eval="False"/>
        </record>

    </data>

    <!-- Fonction Python pour associer les livres après création -->
    <data noupdate="1">
        <function model="biblical.game.settings" name="setup_book_associations"/>
    </data>
</odoo>