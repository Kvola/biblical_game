<odoo>
    <!-- Vue Tree (Liste) -->
    <record id="view_biblical_game_stage_tree" model="ir.ui.view">
        <field name="name">biblical.game.stage.tree</field>
        <field name="model">biblical.game.stage</field>
        <field name="arch" type="xml">
            <tree string="Niveaux de Jeu" decoration-muted="is_active==False">
                <field name="name"/>
                <field name="level"/>
                <field name="bronze_threshold" widget="progressbar" options="{'editable': True}"/>
                <field name="silver_threshold" widget="progressbar" options="{'editable': True}"/>
                <field name="gold_threshold" widget="progressbar" options="{'editable': True}"/>
                <field name="is_active" string="Actif" widget="boolean_button"/>
            </tree>
        </field>
    </record>

    <!-- Vue Form (Formulaire) -->
    <record id="view_biblical_game_stage_form" model="ir.ui.view">
        <field name="name">biblical.game.stage.form</field>
        <field name="model">biblical.game.stage</field>
        <field name="arch" type="xml">
            <form string="Niveau de Jeu">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="is_active"/>
                            <field name="unlock_score"/>
                        </group>
                        <group>
                            <field name="bronze_threshold"/>
                            <field name="silver_threshold"/>
                            <field name="gold_threshold"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour accéder au modèle -->
    <record id="action_biblical_game_stage" model="ir.actions.act_window">
        <field name="name">Niveaux de Jeu</field>
        <field name="res_model">biblical.game.stage</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_is_active': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez ici les différents niveaux du jeu avec leurs seuils de médailles
            </p>
        </field>
    </record>
</odoo>