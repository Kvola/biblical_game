<odoo>
     <data>
        <!-- Actions -->
        <record id="action_open_user_guide" model="ir.actions.act_url">
            <field name="name">Guide Utilisateur</field>
            <field name="url">/user-guide</field>
            <field name="target">self</field>
        </record>

        <!-- Menu principal -->
        <menuitem id="menu_biblical_game_root" name="Jeu Biblique" sequence="10" web_icon="biblical_game,static/description/icon.png"/>
        
        <!-- Sous-menu Configuration -->
        <menuitem id="menu_biblical_game_configuration" name="Configuration" parent="menu_biblical_game_root" sequence="10"/>
            <menuitem id="menu_biblical_game_settings" name="Paramètres du Jeu" parent="menu_biblical_game_configuration" sequence="10" action="action_biblical_game_settings"/>
            <menuitem id="menu_biblical_game_stages" name="Niveaux de Jeu" parent="menu_biblical_game_configuration" sequence="20" action="action_biblical_game_stage"/>
            <menuitem id="menu_configuration_guide" name="Guide Utilisateur" parent="menu_biblical_game_configuration" action="action_open_user_guide" sequence="100"/>

        <!-- Sous-menu Sessions de Jeu -->
        <menuitem id="menu_biblical_game_sessions" name="Sessions de Jeu" parent="menu_biblical_game_root" sequence="30"/>
            <menuitem id="menu_all_sessions" name="Toutes les Sessions" parent="menu_biblical_game_sessions" sequence="10" action="action_biblical_game_session"/>
            <menuitem id="menu_active_sessions" name="Sessions Actives" parent="menu_biblical_game_sessions" sequence="20" action="action_biblical_game_session_active"/>
        
        <!-- Sous-menu Données Bibliques -->
        <menuitem id="menu_biblical_data" name="Données Bibliques" parent="menu_biblical_game_root" sequence="20"/>
            <menuitem id="menu_biblical_books" name="Livres" parent="menu_biblical_data" sequence="10" action="action_biblical_book_tree"/>
            <menuitem id="menu_biblical_chapters" name="Chapitres" parent="menu_biblical_data" sequence="20" action="action_biblical_chapter_tree"/>
            <menuitem id="menu_biblical_verses" name="Versets" parent="menu_biblical_data" sequence="30" action="action_biblical_verse_tree"/>
    </data>
</odoo>